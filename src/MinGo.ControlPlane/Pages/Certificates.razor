@page "/certificates"
@inject IApiManagementService ApiManagementService
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>证书管理 - MinGo API网关</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold mb-2">证书管理</h2>
        <p class="text-secondary">上传和管理域名SSL证书</p>
    </div>
    <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100"
            @onclick="OpenUploadModal">
        <i class="fa fa-upload mr-2"></i>上传证书
    </button>
</div>

@if (certificates == null)
{
    <div class="flex justify-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary"></div>
    </div>
}
else if (!certificates.Any())
{
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-12 text-center">
        <i class="fa fa-lock text-6xl text-gray-400 mb-4"></i>
        <h3 class="text-xl font-semibold mb-2">暂无证书</h3>
        <p class="text-secondary mb-6">点击上方按钮上传第一个证书</p>
        <button class="px-6 py-3 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100"
                @onclick="OpenUploadModal">
            <i class="fa fa-upload mr-2"></i>上传证书
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @foreach (var cert in certificates)
        {
            var daysUntilExpiry = cert.ExpiresAt.HasValue ? (cert.ExpiresAt.Value - DateTimeOffset.Now).Days : 0;
            var isExpiringSoon = daysUntilExpiry <= 30 && daysUntilExpiry > 0;
            var isExpired = daysUntilExpiry <= 0;

            <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300 hover:shadow-md">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-lg flex items-center justify-center @(isExpired ? "bg-danger/20" : isExpiringSoon ? "bg-warning/20" : "bg-success/20")">
                            <i class="fa fa-certificate text-xl @(isExpired ? "text-danger" : isExpiringSoon ? "text-warning" : "text-success")"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">@cert.DomainName</h3>
                            <p class="text-sm text-secondary">@cert.CertificateType</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 text-xs font-medium rounded-full @(isExpired ? "bg-danger/10 text-danger" : isExpiringSoon ? "bg-warning/10 text-warning" : "bg-success/10 text-success")">
                        @(isExpired ? "已过期" : isExpiringSoon ? $"还有 {daysUntilExpiry} 天过期" : "有效")
                    </span>
                </div>

                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-secondary">颁发者</span>
                        <span class="font-medium truncate max-w-[60%]" title="@cert.Issuer">@cert.Issuer</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-secondary">主题</span>
                        <span class="font-medium truncate max-w-[60%]" title="@cert.Subject">@cert.Subject</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-secondary">指纹</span>
                        <span class="font-mono text-xs truncate max-w-[60%]" title="@cert.Thumbprint">@cert.Thumbprint</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-secondary">有效期至</span>
                        <span class="font-medium">@(cert.ExpiresAt.HasValue ? cert.ExpiresAt.Value.ToString("yyyy-MM-dd") : "未知")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-secondary">上传时间</span>
                        <span class="font-medium">@cert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </div>

                <div class="border-t border-gray-200 dark:border-dark-200 pt-4 mt-4 flex justify-end space-x-2">
                    <button class="px-3 py-2 rounded-lg font-medium text-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-red-100 text-red-700 hover:bg-red-200"
                            @onclick="() => DeleteCertificate(cert.Id)">
                        <i class="fa fa-trash mr-1"></i>删除
                    </button>
                </div>
            </div>
        }
    </div>
}

@if (showUploadModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="CloseModal">
        <div class="bg-white dark:bg-dark-100 rounded-xl shadow-xl max-w-lg w-full" @onclick:stopPropagation>
            <div class="p-6 border-b border-gray-200 dark:border-dark-200">
                <h3 class="text-xl font-semibold">上传证书</h3>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-2">域名</label>
                    <input type="text" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 focus:ring-2 focus:ring-primary focus:border-transparent"
                           @bind="domainName"
                           placeholder="例如: api.example.com" />
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">证书文件 (.pfx, .p12, .cer)</label>
                    <div class="relative">
                        <div class="@(selectedFile == null ? "border-2 border-dashed" : "border-2 border-solid") border-primary/50 bg-primary/5 dark:bg-primary/10 rounded-xl p-8 text-center transition-all duration-200 hover:border-primary hover:bg-primary/10 dark:hover:bg-primary/20">
                            @if (selectedFile == null)
                            {
                                <InputFile class="opacity-0 absolute inset-0 w-full h-full cursor-pointer"
                                           OnChange="HandleFileSelected"
                                           accept=".pfx,.p12,.cer" />
                                <div class="pointer-events-none">
                                    <i class="fa fa-cloud-upload-alt text-5xl text-primary mb-4"></i>
                                    <p class="font-medium text-gray-800 dark:text-gray-100 mb-2">点击或拖拽文件到此处</p>
                                    <p class="text-sm text-gray-500 dark:text-gray-400">支持 .pfx, .p12, .cer 格式，最大 10MB</p>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-center space-x-4">
                                    <div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center">
                                        <i class="fa fa-file text-xl"></i>
                                    </div>
                                    <div class="text-left">
                                        <p class="font-medium text-gray-800 dark:text-gray-100">@selectedFile.Name</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400">@(selectedFile.Size / 1024) KB</p>
                                    </div>
                                    <button type="button" 
                                            class="p-2 text-gray-400 hover:text-danger transition-colors"
                                            @onclick="ClearSelectedFile">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                                <InputFile class="opacity-0 absolute inset-0 w-full h-full cursor-pointer"
                                           OnChange="HandleFileSelected"
                                           accept=".pfx,.p12,.cer" />
                            }
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">密码 (可选)</label>
                    <input type="password" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 focus:ring-2 focus:ring-primary focus:border-transparent"
                           @bind="certificatePassword"
                           placeholder="如果证书有密码请输入" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="p-3 bg-danger/10 border border-danger/20 rounded-lg text-danger text-sm">
                        <i class="fa fa-exclamation-circle mr-2"></i>@errorMessage
                    </div>
                }
            </div>
            <div class="p-6 border-t border-gray-200 dark:border-dark-200 flex justify-end space-x-3">
                <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gray-100 text-gray-800 dark:bg-dark-100 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-dark-200"
                        @onclick="CloseModal">
                    取消
                </button>
                <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100 disabled:opacity-50 disabled:cursor-not-allowed"
                        @onclick="UploadCertificate"
                        disabled="@(isUploading || selectedFile == null || string.IsNullOrEmpty(domainName))">
                    @if (isUploading)
                    {
                        <span><i class="fa fa-spinner fa-spin mr-2"></i>上传中...</span>
                    }
                    else
                    {
                        <span><i class="fa fa-upload mr-2"></i>上传</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<CertificateConfig>? certificates;
    private bool showUploadModal;
    private IBrowserFile? selectedFile;
    private string domainName = string.Empty;
    private string certificatePassword = string.Empty;
    private bool isUploading;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificatesAsync();
    }

    private async Task LoadCertificatesAsync()
    {
        certificates = await ApiManagementService.GetCertificatesAsync();
    }

    private void OpenUploadModal()
    {
        showUploadModal = true;
        selectedFile = null;
        domainName = string.Empty;
        certificatePassword = string.Empty;
        errorMessage = string.Empty;
    }

    private void CloseModal()
    {
        showUploadModal = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = string.Empty;
    }

    private void ClearSelectedFile()
    {
        selectedFile = null;
    }

    private async Task UploadCertificate()
    {
        if (selectedFile == null || string.IsNullOrEmpty(domainName))
            return;

        isUploading = true;
        errorMessage = string.Empty;

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            content.Add(fileContent, "certificateFile", selectedFile.Name);
            content.Add(new StringContent(domainName), "domainName");

            if (!string.IsNullOrEmpty(certificatePassword))
            {
                content.Add(new StringContent(certificatePassword), "password");
            }

            var response = await Http.PostAsync("api/certificates/upload", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadCertificatesAsync();
                CloseModal();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"上传失败: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"上传出错: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteCertificate(string id)
    {
        await ApiManagementService.DeleteCertificateAsync(id);
        await LoadCertificatesAsync();
    }
}
