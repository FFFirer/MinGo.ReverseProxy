@page "/instances"
@using MinGo.Shared.Models
@using MinGo.ControlPlane.Services
@using System.Text.Json

<PageTitle>实例管理 - MinGo API网关</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold mb-2">实例管理</h2>
    <p class="text-secondary">管理网关实例的在线状态和配置</p>
</div>

<div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300 mb-6">
    <h3 class="font-semibold mb-4">实例统计</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="p-4 bg-gray-50 dark:bg-dark-200 rounded-lg">
            <p class="text-secondary text-sm mb-1">总实例数</p>
            <h4 class="text-2xl font-bold">@(instances?.Instances.Count ?? 0)</h4>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-dark-200 rounded-lg">
            <p class="text-secondary text-sm mb-1">活跃实例</p>
            <h4 class="text-2xl font-bold text-success">@onlineCount</h4>
        </div>
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4 gap-4">
        <div class="relative flex-1 max-w-md">
            <input type="text" placeholder="搜索实例..." class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200 pr-10">
            <i class="fa fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        </div>
        <div class="flex space-x-2">
            <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 shrink-0" @onclick="LoadInstances">
                <i class="fa fa-refresh mr-2"></i>刷新
            </button>
            <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gray-100 text-gray-800 dark:bg-dark-100 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-dark-200 shrink-0">
                <i class="fa fa-filter mr-2"></i>筛选
            </button>
        </div>
    </div>

    @if (instances == null) {
        <div class="text-center py-8">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary"></div>
            <p class="mt-4 text-secondary">加载实例中...</p>
        </div>
    } else if (instances.Instances.Count == 0) {
        <div class="text-center py-8">
            <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-dark-200 flex items-center justify-center mx-auto mb-4">
                <i class="fa fa-server text-2xl text-gray-400"></i>
            </div>
            <p class="text-secondary">没有找到网关实例</p>
            <p class="text-sm text-secondary mt-2">网关实例将自动注册</p>
        </div>
    } else {
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-dark-200">
                        <th class="text-left py-3 px-4 font-medium text-secondary">实例名称</th>
                        <th class="text-left py-3 px-4 font-medium text-secondary">IP地址</th>
                        <th class="text-left py-3 px-4 font-medium text-secondary">状态</th>
                        <th class="text-left py-3 px-4 font-medium text-secondary">最后在线</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instance in instances.Instances) {
                        <tr class="border-b border-gray-100 dark:border-dark-100 hover:bg-gray-50 dark:hover:bg-dark-100/50">
                            <td class="py-3 px-4 font-medium">@instance.Name</td>
                            <td class="py-3 px-4">@instance.Address</td>
                            <td class="py-3 px-4">
                                @if (instance.Status == GatewayInstanceStatus.Online) {
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">在线</span>
                                } else if (instance.Status == GatewayInstanceStatus.HeartbeatTimeout) {
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">心跳超时</span>
                                } else if (instance.Status == GatewayInstanceStatus.Unhealthy) {
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400">不健康</span>
                                } else if (instance.Status == GatewayInstanceStatus.Offline) {
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400">离线</span>
                                } else {
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400">未知</span>
                                }
                            </td>
                            <td class="py-3 px-4">@instance.LastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private ILogger<Instances> Logger { get; set; } = null!;

    private GatewayInstanceListResponse? instances;
    private int onlineCount => instances?.OnlineCount ?? 0;
    private CancellationTokenSource? _refreshTimerCancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstances();
        StartRefreshTimer();
    }

    private async Task LoadInstances()
    {
        try {
            var client = HttpClientFactory.CreateClient();
            var url = NavigationManager.BaseUri.TrimEnd('/') + "/api/instances";
            instances = await client.GetFromJsonAsync<GatewayInstanceListResponse>(url);
        } catch (Exception ex) {
            Logger.LogError(ex, "Failed to load instances");
        }
    }

    private void StartRefreshTimer()
    {
        // 清理之前的定时器
        if (_refreshTimerCancellationTokenSource != null)
        {
            _refreshTimerCancellationTokenSource.Cancel();
            _refreshTimerCancellationTokenSource.Dispose();
        }

        _refreshTimerCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _refreshTimerCancellationTokenSource.Token;

        // 每5分钟刷新一次
        _ = Task.Run(async () =>
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromMinutes(5), cancellationToken);
                if (!cancellationToken.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadInstances();
                    });
                }
            }
        }, cancellationToken);
    }

    public void Dispose()
    {
        if (_refreshTimerCancellationTokenSource != null)
        {
            _refreshTimerCancellationTokenSource.Cancel();
            _refreshTimerCancellationTokenSource.Dispose();
        }
    }
}

@implements IDisposable

