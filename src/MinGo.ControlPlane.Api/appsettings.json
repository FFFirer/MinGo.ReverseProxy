{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "serviceName": "min-go-control-plane"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "min-go-control-plane"
  },
  "Portainer": {
    "Enabled": false,
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "CacheSeconds": 30,
    "HostAddress": "",
    "DataPlaneService": "data-plane",
    "SelfStackNames": [],
    "SelfImagePatterns": [ "reverseproxy-cp" ],
    "ExtraExcludedStacks": []
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mingocp.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5000",
        "Protocols": "Http1"
      },
      "gRPC": {
        "Url": "http://+:5001",
        "Protocols": "Http2"
      }
    }
  }
}