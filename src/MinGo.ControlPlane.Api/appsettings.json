{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "serviceName": "min-go-control-plane"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "min-go-control-plane"
  },
  "Portainer": {
    "TimeoutSeconds": 10,
    "CacheSeconds": 30
  },
  "Cloudflare": {
    "ApiToken": "",
    "AccountId": "",
    "TimeoutSeconds": 10,
    "DataPlaneOrigin": "http://data-plane:8080",
    "TunnelOrigins": [],
    "DefaultCatchAll": "http_status:404"
  },
  "CertManager": {
    "SyncIntervalMinutes": 60
  },
  "Messaging": {
    "Enabled": false,
    "Integrations": {
      "SimpleMessageBroker": {
        "Type": "SimpleMessageBroker",
        "BaseAddress": "",
        "ApiKey": "",
        "PollingInterval": "00:00:01",
        "BatchSize": 10,
        "ConsumeTimeoutSeconds": 5
      }
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeysPath": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mingocp.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5000",
        "Protocols": "Http1"
      },
      "gRPC": {
        "Url": "http://+:5001",
        "Protocols": "Http2"
      }
    }
  }
}