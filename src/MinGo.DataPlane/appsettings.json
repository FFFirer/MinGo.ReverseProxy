{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "GrpcUrl": "http://localhost:5001"
  },
   "Kestrel": {
     "Endpoints": {
       "Http": {
         "Url": "http://+:8080"
       },
       "Https": {
         "Url": "https://+:8443"
       }
     }
   }
}
