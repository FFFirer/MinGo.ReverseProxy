{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "GrpcUrl": "http://localhost:5001"
  },
   "Kestrel": {
     "Endpoints": {
       "Http": {
         "Url": "http://+:8080"
       },
       "Https": {
         "Url": "https://+:8443"
       }
     }
   }
}
