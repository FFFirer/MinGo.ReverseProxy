{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ControlPlane": {
    "Url": "https://localhost:7171",
    "ConfigApiPath": "/api/config/latest",
    "TimeoutSeconds": 30,
    "SkipSslCertificateValidation": true
  }
}