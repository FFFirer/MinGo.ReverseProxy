@page "/monitoring"

<PageTitle>监控 - MinGo API网关</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold mb-2">监控</h2>
    <p class="text-secondary">查看网关运行指标和告警</p>
</div>

<div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300 mb-6">
    <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">系统指标</h3>
        <div class="flex space-x-2">
            <select class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200 py-1">
                <option>最近1小时</option>
                <option>最近6小时</option>
                <option>最近24小时</option>
                <option>最近7天</option>
            </select>
        </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="h-64 bg-gray-50 dark:bg-dark-200 rounded-lg flex items-center justify-center">
            <p class="text-secondary">请求量趋势图表</p>
        </div>
        <div class="h-64 bg-gray-50 dark:bg-dark-200 rounded-lg flex items-center justify-center">
            <p class="text-secondary">响应时间趋势图表</p>
        </div>
        <div class="h-64 bg-gray-50 dark:bg-dark-200 rounded-lg flex items-center justify-center">
            <p class="text-secondary">错误率趋势图表</p>
        </div>
        <div class="h-64 bg-gray-50 dark:bg-dark-200 rounded-lg flex items-center justify-center">
            <p class="text-secondary">系统资源使用图表</p>
        </div>
    </div>
</div>

<div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
    <h3 class="font-semibold mb-4">告警记录</h3>
    <div class="space-y-4">
        <div class="p-4 border-l-4 border-danger bg-danger/5 dark:bg-danger/10 rounded-r-lg">
            <div class="flex items-center justify-between">
                <h4 class="font-medium">服务不可用</h4>
                <span class="text-sm text-secondary">2026-02-12 23:00</span>
            </div>
            <p class="text-sm mt-1">订单服务(order-cluster)健康检查失败</p>
            <div class="mt-2 flex space-x-2">
                <button class="text-sm text-primary hover:text-primary/80">
                    <i class="fa fa-eye mr-1"></i>查看详情
                </button>
                <button class="text-sm text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-gray-100">
                    <i class="fa fa-check mr-1"></i>标记已处理
                </button>
            </div>
        </div>
        <div class="p-4 border-l-4 border-warning bg-warning/5 dark:bg-warning/10 rounded-r-lg">
            <div class="flex items-center justify-between">
                <h4 class="font-medium">速率限制触发</h4>
                <span class="text-sm text-secondary">2026-02-12 22:30</span>
            </div>
            <p class="text-sm mt-1">IP 192.168.1.100 触发速率限制</p>
            <div class="mt-2 flex space-x-2">
                <button class="text-sm text-primary hover:text-primary/80">
                    <i class="fa fa-eye mr-1"></i>查看详情
                </button>
                <button class="text-sm text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-gray-100">
                    <i class="fa fa-check mr-1"></i>标记已处理
                </button>
            </div>
        </div>
        <div class="p-4 border-l-4 border-success bg-success/5 dark:bg-success/10 rounded-r-lg">
            <div class="flex items-center justify-between">
                <h4 class="font-medium">服务恢复</h4>
                <span class="text-sm text-secondary">2026-02-12 22:00</span>
            </div>
            <p class="text-sm mt-1">产品服务(product-cluster)健康检查恢复正常</p>
            <div class="mt-2 flex space-x-2">
                <button class="text-sm text-primary hover:text-primary/80">
                    <i class="fa fa-eye mr-1"></i>查看详情
                </button>
                <button class="text-sm text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-gray-100">
                    <i class="fa fa-check mr-1"></i>标记已处理
                </button>
            </div>
        </div>
    </div>
</div>