@page "/security"

<PageTitle>安全管理 - MinGo API网关</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold mb-2">安全管理</h2>
    <p class="text-secondary">配置和管理安全策略</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <h3 class="font-semibold mb-4">API密钥管理</h3>
        <div class="space-y-4">
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-dark-200 rounded-lg">
                <div>
                    <p class="font-medium">service-api-key</p>
                    <p class="text-sm text-secondary">服务调用密钥</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">过期时间: 2026-12-31</p>
                </div>
                <div class="flex items-center space-x-2">
                    <button class="text-primary hover:text-primary/80 text-sm">
                        <i class="fa fa-refresh mr-1"></i>刷新
                    </button>
                    <button class="text-danger hover:text-danger/80 text-sm">
                        <i class="fa fa-trash mr-1"></i>删除
                    </button>
                </div>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-dark-200 rounded-lg">
                <div>
                    <p class="font-medium">client-api-key</p>
                    <p class="text-sm text-secondary">客户端调用密钥</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">过期时间: 2026-06-30</p>
                </div>
                <div class="flex items-center space-x-2">
                    <button class="text-primary hover:text-primary/80 text-sm">
                        <i class="fa fa-refresh mr-1"></i>刷新
                    </button>
                    <button class="text-danger hover:text-danger/80 text-sm">
                        <i class="fa fa-trash mr-1"></i>删除
                    </button>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100 w-full">
                <i class="fa fa-plus mr-2"></i>生成新API密钥
            </button>
        </div>
    </div>

    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <h3 class="font-semibold mb-4">IP访问控制</h3>
        <div class="space-y-6">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <h4 class="font-medium">IP白名单</h4>
                    <button class="text-primary hover:text-primary/80 text-sm">
                        <i class="fa fa-plus mr-1"></i>添加
                    </button>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-dark-200 rounded-lg">
                    <p class="text-sm">192.168.1.0/24</p>
                    <p class="text-sm mt-1">10.0.0.1</p>
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <h4 class="font-medium">IP黑名单</h4>
                    <button class="text-primary hover:text-primary/80 text-sm">
                        <i class="fa fa-plus mr-1"></i>添加
                    </button>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-dark-200 rounded-lg">
                    <p class="text-sm">172.16.0.1</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300 lg:col-span-2">
        <h3 class="font-semibold mb-4">速率限制</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 bg-gray-50 dark:bg-dark-200 rounded-lg">
                <h4 class="font-medium mb-2">全局限制</h4>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm text-secondary mb-1">请求/秒</label>
                        <input type="number" value="1000" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                    <div>
                        <label class="block text-sm text-secondary mb-1">并发连接</label>
                        <input type="number" value="500" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                </div>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-dark-200 rounded-lg">
                <h4 class="font-medium mb-2">按IP限制</h4>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm text-secondary mb-1">请求/秒</label>
                        <input type="number" value="100" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                    <div>
                        <label class="block text-sm text-secondary mb-1">并发连接</label>
                        <input type="number" value="50" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                </div>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-dark-200 rounded-lg">
                <h4 class="font-medium mb-2">按API密钥限制</h4>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm text-secondary mb-1">请求/秒</label>
                        <input type="number" value="50" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                    <div>
                        <label class="block text-sm text-secondary mb-1">并发连接</label>
                        <input type="number" value="25" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 flex justify-end">
            <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100">
                <i class="fa fa-save mr-2"></i>保存配置
            </button>
        </div>
    </div>
</div>