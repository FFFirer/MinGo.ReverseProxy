@page "/security"

<Header PageTitle="安全设置" />

<div class="security">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">安全配置</h5>
            <form>
                <div class="form-group">
                    <label for="apiKey">API 密钥</label>
                    <input type="text" class="form-control" id="apiKey" placeholder="输入 API 密钥">
                </div>
                <div class="form-group">
                    <label for="allowedIps">允许的 IP 地址</label>
                    <input type="text" class="form-control" id="allowedIps" placeholder="逗号分隔的 IP 地址">
                </div>
                <div class="form-group">
                    <label for="rateLimit">速率限制</label>
                    <input type="number" class="form-control" id="rateLimit" placeholder="每分钟请求数">
                </div>
                <button type="submit" class="btn btn-primary">保存设置</button>
            </form>
        </div>
    </div>
</div>

<style>
    .security {
        margin-top: 2rem;
    }
</style>