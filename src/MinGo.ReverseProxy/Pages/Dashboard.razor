@page "/"
@page "/dashboard"

@inject MinGo.Core.Interfaces.IMonitoringService monitoringService
@inject MinGo.Core.Interfaces.IGatewayInstanceService instanceService
@inject IJSRuntime JSRuntime
@using MinGo.Core.Entities
@using MinGo.Core.Models
@using Microsoft.JSInterop

<PageTitle>仪表盘 - MinGo API网关</PageTitle>

<!-- Chart.js 引用 -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="mb-6">
    <h2 class="text-2xl font-bold mb-2">仪表盘</h2>
    <p class="text-secondary">实时监控网关运行状态</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-secondary text-sm">总请求数</p>
                <h3 class="text-2xl font-bold">@metricsSummary?.TotalRequests.ToString("N0")</h3>
                <p class="text-success text-sm mt-1"><i class="fa fa-refresh"></i> 实时</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                <i class="fa fa-refresh"></i>
            </div>
        </div>
    </div>
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-secondary text-sm">错误率</p>
                <h3 class="text-2xl font-bold">@($"{metricsSummary?.ErrorRate:F1}%")</h3>
                <p class="@(metricsSummary?.ErrorRate > 2 ? "text-danger" : "text-success") text-sm mt-1">
                    <i class="fa fa-exclamation-circle"></i> @metricsSummary?.ErrorRequests.ToString("N0") 个错误
                </p>
            </div>
            <div class="w-12 h-12 rounded-full bg-danger/10 flex items-center justify-center text-danger">
                <i class="fa fa-exclamation-circle"></i>
            </div>
        </div>
    </div>
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-secondary text-sm">平均响应时间</p>
                <h3 class="text-2xl font-bold">@($"{metricsSummary?.AverageResponseTime:F0}ms")</h3>
                <p class="text-success text-sm mt-1"><i class="fa fa-clock-o"></i> 实时</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-success/10 flex items-center justify-center text-success">
                <i class="fa fa-clock-o"></i>
            </div>
        </div>
    </div>
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-secondary text-sm">活跃服务</p>
                <h3 class="text-2xl font-bold">@onlineInstanceCount/@totalInstanceCount</h3>
                <p class="text-success text-sm mt-1">全部正常</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-warning/10 flex items-center justify-center text-warning">
                <i class="fa fa-server"></i>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <h3 class="font-semibold mb-4">请求趋势</h3>
        <div class="h-64">
            <canvas id="requestsChart"></canvas>
        </div>
    </div>
    <div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
        <h3 class="font-semibold mb-4">服务状态</h3>
        <div class="space-y-4">
            @if (serviceMetrics?.Any() == true)
            {
                @foreach (var service in serviceMetrics.Take(5))
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-3 h-3 rounded-full @(service.ErrorRate < 5 ? "bg-success" : service.ErrorRate < 20 ? "bg-warning" : "bg-danger")"></div>
                            <span class="truncate max-w-[120px]" title="@service.ServiceName">@GetServiceDisplayName(service.ServiceName)</span>
                        </div>
                        <div class="w-1/2 bg-gray-200 dark:bg-dark-200 rounded-full h-2">
                            <div class="@(service.ErrorRate < 5 ? "bg-success" : service.ErrorRate < 20 ? "bg-warning" : "bg-danger") h-2 rounded-full" style="width: @(100 - service.ErrorRate)%"></div>
                        </div>
                        <span class="text-sm">@($"{100 - service.ErrorRate:F0}%")</span>
                    </div>
                }
            }
            else
            {
                <p class="text-secondary text-center py-4">暂无服务数据</p>
            }
        </div>
    </div>
</div>

<div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
    <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">路由请求统计</h3>
        <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gray-100 text-gray-800 dark:bg-dark-100 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-dark-200 text-sm py-1">查看全部</button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-200 dark:border-dark-200">
                    <th class="text-left py-3 px-4 font-medium text-secondary">路由</th>
                    <th class="text-left py-3 px-4 font-medium text-secondary">总请求</th>
                    <th class="text-left py-3 px-4 font-medium text-secondary">错误数</th>
                    <th class="text-left py-3 px-4 font-medium text-secondary">错误率</th>
                    <th class="text-left py-3 px-4 font-medium text-secondary">平均响应</th>
                </tr>
            </thead>
            <tbody>
                @if (serviceMetrics?.Any() == true)
                {
                    @foreach (var service in serviceMetrics)
                    {
                        <tr class="border-b border-gray-100 dark:border-dark-100 hover:bg-gray-50 dark:hover:bg-dark-100/50">
                            <td class="py-3 px-4 font-medium">@GetServiceDisplayName(service.ServiceName)</td>
                            <td class="py-3 px-4">@service.TotalRequests.ToString("N0")</td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-1 text-xs font-medium rounded-full @(service.ErrorRequests > 0 ? "bg-danger/10 text-danger" : "bg-success/10 text-success")">
                                    @service.ErrorRequests.ToString("N0")
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-1 text-xs font-medium rounded-full @(service.ErrorRate < 5 ? "bg-success/10 text-success" : service.ErrorRate < 20 ? "bg-warning/10 text-warning" : "bg-danger/10 text-danger")">
                                    @($"{service.ErrorRate:F1}%")
                                </span>
                            </td>
                            <td class="py-3 px-4">@($"{service.AverageResponseTime:F0}ms")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-8 text-center text-secondary">暂无请求数据</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private MetricsSummary? metricsSummary;
    private IEnumerable<ServiceMetrics>? serviceMetrics;
    private IEnumerable<RequestMetrics>? requestMetrics;
    private int onlineInstanceCount;
    private int totalInstanceCount;
    private System.Threading.Timer? refreshTimer;
    private string chartScript = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
        refreshTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(async () => await RefreshDataAsync()),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
    }

    private async Task RefreshDataAsync()
    {
        try
        {
            metricsSummary = await monitoringService.GetMetricsSummaryAsync();
            serviceMetrics = await monitoringService.GetServiceMetricsAsync();
            
            // 获取过去1小时的请求指标
            var endTime = DateTimeOffset.UtcNow;
            var startTime = endTime.AddHours(-1);
            requestMetrics = await monitoringService.GetRequestMetricsAsync(startTime, endTime);

            var instances = await instanceService.GetInstancesAsync();
            totalInstanceCount = instances.Instances.Count;
            onlineInstanceCount = instances.Instances.Count(i => i.Status == GatewayInstanceStatus.Online);

            await InvokeAsync(StateHasChanged);
            
            // 更新图表
            UpdateChart();
        }
        catch
        {
        }
    }

    private void UpdateChart()
    {
        if (requestMetrics == null) return;
        
        var labels = requestMetrics.Select(m => m.Timestamp.ToString("HH:mm")).ToArray();
        var counts = requestMetrics.Select(m => m.Count).ToArray();
        var errorCounts = requestMetrics.Select(m => m.ErrorCount).ToArray();
        
        chartScript = $@"
            var ctx = document.getElementById('requestsChart').getContext('2d');
            
            // 销毁旧图表
            if (window.requestsChart) {{
                window.requestsChart.destroy();
            }}
            
            window.requestsChart = new Chart(ctx, {{
                type: 'line',
                data: {{
                    labels: {System.Text.Json.JsonSerializer.Serialize(labels)},
                    datasets: [
                        {{
                            label: '总请求数',
                            data: {System.Text.Json.JsonSerializer.Serialize(counts)},
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            tension: 0.4,
                            fill: true
                        }},
                        {{
                            label: '错误请求数',
                            data: {System.Text.Json.JsonSerializer.Serialize(errorCounts)},
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            tension: 0.4,
                            fill: true
                        }}
                    ]
                }},
                options: {{
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {{
                        legend: {{
                            position: 'top',
                        }},
                        tooltip: {{
                            mode: 'index',
                            intersect: false
                        }}
                    }},
                    scales: {{
                        y: {{
                            beginAtZero: true,
                            title: {{
                                display: true,
                                text: '请求数'
                            }}
                        }},
                        x: {{
                            title: {{
                                display: true,
                                text: '时间'
                            }}
                        }}
                    }}
                }}
            }});
        ";
        
        // 执行图表脚本
        JSRuntime.InvokeAsync<object>("eval", chartScript);
    }

    private string GetServiceDisplayName(string route)
    {
        if (string.IsNullOrEmpty(route) || route == "unknown")
            return "未知路由";

        if (route.StartsWith("gateway.request:"))
        {
            return route.Substring("gateway.request:".Length).Trim();
        }

        return route;
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
