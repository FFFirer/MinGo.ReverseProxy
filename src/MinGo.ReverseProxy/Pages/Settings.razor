@page "/settings"

<PageTitle>设置 - MinGo API网关</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold mb-2">设置</h2>
    <p class="text-secondary">配置网关全局设置</p>
</div>

<div class="bg-white dark:bg-dark-100 rounded-xl shadow-sm border border-gray-200 dark:border-dark-200 p-6 transition-all duration-300">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
            <h3 class="font-semibold mb-4">基本设置</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">网关名称</label>
                    <input type="text" value="MinGo API Gateway" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">监听端口</label>
                    <input type="number" value="8080" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">HTTPS端口</label>
                    <input type="number" value="8443" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">最大请求体大小</label>
                    <div class="flex items-center space-x-2">
                        <input type="number" value="10" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                        <span class="text-secondary">MB</span>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <h3 class="font-semibold mb-4">高级设置</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">健康检查间隔</label>
                    <div class="flex items-center space-x-2">
                        <input type="number" value="10" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                        <span class="text-secondary">秒</span>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">超时时间</label>
                    <div class="flex items-center space-x-2">
                        <input type="number" value="30" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                        <span class="text-secondary">秒</span>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">日志级别</label>
                    <select class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-dark-200 bg-white dark:bg-dark-200 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-200">
                        <option>INFO</option>
                        <option>DEBUG</option>
                        <option>WARN</option>
                        <option>ERROR</option>
                    </select>
                </div>
                <div class="flex items-center justify-between">
                    <label class="text-sm font-medium">启用HTTPS</label>
                    <div class="relative inline-block w-10 mr-2 align-middle select-none">
                        <input type="checkbox" checked class="absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer checked:right-0 checked:border-primary transition-all duration-200">
                        <label class="block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-6 flex justify-end space-x-2">
        <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gray-100 text-gray-800 dark:bg-dark-100 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-dark-200">
            <i class="fa fa-undo mr-2"></i>重置
        </button>
        <button class="px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-primary/90 focus:ring-primary/50 focus:ring-offset-white dark:focus:ring-offset-dark-100">
            <i class="fa fa-save mr-2"></i>保存设置
        </button>
    </div>
</div>