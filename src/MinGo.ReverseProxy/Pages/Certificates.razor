@page "/certificates"

<Header PageTitle="证书管理" />

<div class="certificates">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">证书列表</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>域名</th>
                        <th>颁发者</th>
                        <th>到期日期</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>example.com</td>
                        <td>Let's Encrypt</td>
                        <td>2027-03-06</td>
                        <td>有效</td>
                        <td>
                            <button class="btn btn-sm btn-primary">查看</button>
                            <button class="btn btn-sm btn-danger">删除</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .certificates {
        margin-top: 2rem;
    }
</style>