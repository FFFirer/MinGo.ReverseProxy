@if (IsMobileMenuOpen)
{
    <div class="fixed inset-0 top-[61px] bg-black bg-opacity-50 z-30 md:hidden" @onclick="CloseMobileMenu"></div>
}

@code {
    private string GetSidebarClass()
    {
        var baseClass = "fixed inset-y-0 left-0 top-[61px] w-64 bg-white dark:bg-dark-100 border-r border-gray-200 dark:border-dark-200 flex flex-col transition-transform duration-300 ease-in-out z-40";
        
        if (IsMobileMenuOpen)
        {
            return $"{baseClass} translate-x-0";
        }
        
        return $"{baseClass} -translate-x-full md:translate-x-0";
    }

    private string GetSidebarItemClass(string page)
    {
        var baseClass = "flex items-center space-x-3 px-3 py-2 rounded-lg transition-all duration-200 cursor-pointer";
        
        if (currentPage == page)
        {
            return $"{baseClass} bg-primary text-white";
        }
        
        return $"{baseClass} hover:bg-gray-100 dark:hover:bg-dark-100";
    }

    private async Task CloseMobileMenu()
    {
        await IsMobileMenuOpenChanged.InvokeAsync(false);
    }
}
