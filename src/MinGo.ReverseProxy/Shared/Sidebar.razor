@inject NavigationManager NavigationManager

@code {
    private string? currentPage;

    [Parameter]
    public bool IsMobileMenuOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsMobileMenuOpenChanged { get; set; }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateCurrentPage();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage();
        StateHasChanged();
    }

    private void UpdateCurrentPage()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        currentPage = uri.AbsolutePath.Trim('/');
        if (string.IsNullOrEmpty(currentPage))
        {
            currentPage = "dashboard";
        }
    }

    private async Task NavigateTo(string page)
    {
        currentPage = page;
        NavigationManager.NavigateTo($"/{page}");
        
        if (IsMobileMenuOpen)
        {
            await IsMobileMenuOpenChanged.InvokeAsync(false);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

