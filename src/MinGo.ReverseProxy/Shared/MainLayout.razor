@inherits LayoutComponentBase

<PageTitle>MinGo API网关控制平面</PageTitle>

<div class="h-screen flex flex-col overflow-hidden relative">
    
    <Header @ref="headerRef" OnToggleMobileMenu="ToggleMobileSidebar" />

    <div class="flex flex-1 overflow-hidden relative">
        <Sidebar @ref="sidebarRef" IsMobileMenuOpen="isMobileMenuOpen" IsMobileMenuOpenChanged="OnMobileMenuOpenChanged" />
        
        <div class="flex-1 flex flex-col overflow-hidden md:ml-64">
            <main class="flex-1 overflow-y-auto p-6">
                @Body
            </main>
        </div>
    </div>
</div>

@code {
    private Header? headerRef;
    private Sidebar? sidebarRef;
    private bool isMobileMenuOpen = false;

    private void ToggleMobileSidebar()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void OnMobileMenuOpenChanged(bool value)
    {
        isMobileMenuOpen = value;
    }
}
