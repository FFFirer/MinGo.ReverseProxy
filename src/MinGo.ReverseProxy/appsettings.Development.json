{
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Vite": {
    "Server": {
      "PackageManager": "pnpm",
      "AutoRun": true,
      "Port": 6139
    }
  },
  "AdminPorts": [58074],
  "ProxyPorts": [5286, 7064],
  "ControlPlane": {
    "Url": "https://localhost:58074",
    "ConfigApiPath": "/api/config/latest",
    "TimeoutSeconds": 30,
    "SkipSslCertificateValidation": true
  }
}
