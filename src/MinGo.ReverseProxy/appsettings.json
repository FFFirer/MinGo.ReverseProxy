{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Name": "Gateway-Default",
    "Version": "1.0.0"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gateway.db"
  },
  "HttpClient": {
    "Clients": {
      "Default": {
        "BaseAddress": "http://localhost:58074",
        "Timeout": "00:01:00"
      }
    }
  }
}