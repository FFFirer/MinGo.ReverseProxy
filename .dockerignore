# =========================
frontend/min-go-console/dist/
frontend/min-go-console/node_modules/

# =========================
# Documentation
# =========================
docs/
*.md
LICENSE

# =========================
# CI/CD (not needed in build)
# =========================
.gitea/
.github/
.azure/

# =========================
# Test / E2E
# =========================
**/e2e/
**/*.test.*
**/*.spec.*
**/TestResults/
**/playwright-report/

# =========================
# Docker (avoid recursive)
# =========================
**/Dockerfile
**/.dockerignore
docker-compose*.yml

